# ── 镜像 ──
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_HUB_IMAGE=agentmemory/memory-hub:latest
PROXY_IMAGE=agentmemory/memory-proxy:latest

# ── PostgreSQL（必填：PG 存储后端连接串）──
# 指向 tdai_memory 库；数据库和扩展可用 patches/create-db.js 创建
PG_CONNECTION_STRING=postgres://postgres:<password>@<pg-host>:5432/tdai_memory

# ── LLM（OpenAI 兼容端点，示例为 DashScope）──
MEMORY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_LLM_API_KEY=<your-api-key>
MEMORY_LLM_MODEL=qwen3.5-27b
MEMORY_LLM_PROTOCOL=openai

PROXY_UPSTREAM_URL=https://dashscope.aliyuncs.com/apps/anthropic/v1
PROXY_UPSTREAM_API_KEY=<your-api-key>
PROXY_UPSTREAM_MODEL=qwen3.5-27b

# ── 端口 ──
MEMORY_CORE_PORT=8420
PANEL_PORT=18125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

# ── 对外地址（改成部署机可达地址）──
KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3
MEMORY_HUB_PROXY_PUBLIC_URL=http://<server-ip>:8096

# ── 数据卷 ──
MEMORY_CORE_VOLUME=tdai-memory-core-data
PANEL_VOLUME=tdai-panel-data

# ── Gateway 内部管理凭据（留空 = 关闭 Bearer gate，见 start-memory-core.sh 说明）──
MEMORY_CORE_GATEWAY_API_KEY=
MEMORY_CORE_ADMIN_USERNAME=admin

# ── Embedding 服务（OpenAI 兼容，1024 维，示例为本地 BGE-M3）──
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=http://<server-ip>:8121/v1/
EMBEDDING_API_KEY=<embedding-api-key>
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=false
